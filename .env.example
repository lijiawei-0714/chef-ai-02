# ==================== 阿里云百炼（必需） ====================
ALI_KEY=你的阿里云百炼API密钥
ali_URL=你的阿里云百炼API地址

# ==================== LangSmith 追踪（可选） ====================
LANGSMITH_TRACING_V2=true
LANGSMITH_API_KEY=你的LangSmith API密钥
LANGSMITH_PROJECT=AI-SICHU

# ==================== Tavily 智能搜索（可选） ====================
TAVILY_API_KEY=你的Tavily API密钥

# ==================== DeepSeek（可选） ====================
DEEPSEEK_KEY=你的DeepSeek API密钥

# ==================== 阿里云 OSS 图片上传（可选） ====================
OSS_ACCESS_KEY_ID=你的OSS AccessKey ID
OSS_ACCESS_KEY_SECRET=你的OSS AccessKey Secret
OSS_ENDPOINT=你的OSS Endpoint
OSS_BUCKET_NAME=你的OSS Bucket名称